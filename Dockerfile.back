FROM docker:27-cli AS docker-cli

FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY pom.xml mvnw mvnw.cmd ./
COPY .mvn .mvn
COPY api-generator-core api-generator-core
COPY api-generator-runtime api-generator-runtime
COPY api-generator-back api-generator-back
COPY api-generator-front api-generator-front
COPY api-generator-template api-generator-template
RUN mvn -q -pl api-generator-core,api-generator-runtime -am install -DskipTests \
    && mvn -q -pl api-generator-back -am -DskipTests package

FROM eclipse-temurin:21-jdk
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/* \
    && groupadd --system apigen && useradd --system --gid apigen --home-dir /app apigen
ENV MAVEN_HOME=/usr/share/maven \
    MAVEN_USER_HOME=/app/.m2
COPY --from=build /usr/share/maven /usr/share/maven
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY --from=build /workspace/api-generator-back/target/*.jar /app/app.jar
COPY --from=build /workspace/api-generator-template /app/api-generator-template
COPY --from=build /root/.m2/repository/com/api /app/.m2/repository/com/api
RUN ln -sf /usr/share/maven/bin/mvn /usr/local/bin/mvn \
    && chown -R apigen:apigen /app
USER apigen
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=5 CMD curl -fsS http://localhost:8080/actuator/health | grep -q '"status":"UP"' || exit 1
ENTRYPOINT ["java","-jar","/app/app.jar"]
