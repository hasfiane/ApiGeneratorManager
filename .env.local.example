# Local-only example. Copy to .env.local and replace every change-me value.
MANAGER_DB_NAME=apigen_manager
MANAGER_DB_USER=apigen
MANAGER_DB_PASSWORD=change-me-local-db-password
MANAGER_DB_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=3000
CLOUDBEAVER_PORT=8978
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
APP_GENERATION_DOCKER_DEPLOYMENT_ENABLED=true
GENERATED_API_BOOTSTRAP_USER=local-admin
GENERATED_API_BOOTSTRAP_PASSWORD=change-me-generated-api-password
GENERATED_API_JWT_SECRET=change-me-generated-api-jwt-secret-at-least-32-chars
GENERATED_API_JWT_ISSUER=generated-api
GENERATED_API_JWT_EXP_SECONDS=3600

MANAGER_JWT_SECRET=change-me-manager-jwt-secret-at-least-32-chars
MANAGER_JWT_ISSUER=api-generator-manager
MANAGER_JWT_EXP_SECONDS=3600

BOOTSTRAP_EMAIL=local-admin@example.test
BOOTSTRAP_PASSWORD=change-me-manager-password

APP_ACCOUNT_EMAIL_VERIFICATION_ENABLED=true
APP_ACCOUNT_EMAIL_VERIFICATION_FROM=no-reply@apigen.local
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_SECURITY_JDBC_ALLOW_PRIVATE_HOSTS=true
APP_SECURITY_JDBC_ALLOWED_HOSTS=
OAUTH2_SUCCESS_REDIRECT=http://localhost:3000/oauth2/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
